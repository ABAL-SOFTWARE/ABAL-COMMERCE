# Image (si subes la imagen a GHCR o Docker Hub, pon ej: ghcr.io/tu-usuario/refer-api)
APP_IMAGE=ghcr.io/cobyzero/refer-api
APP_IMAGE_TAG=1.0.0

# Server
PORT=3000
HOST_PORT=3001

# Database - PostgreSQL (incluida en docker-compose)
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
# Generar: openssl rand -hex 16
DB_PASSWORD=
DB_NAME=refer
DB_SSLMODE=disable

# Opcional: si usas una PostgreSQL externa, define DATABASE_URL:
# DATABASE_URL=postgres://user:pass@host:5432/dbname?sslmode=disable

# Pool tuning (opcional)
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_SEC=300

# Auth / Ory Kratos (generar secretos antes de arrancar)
#   openssl rand -base64 48   # AUTH_JWT_SECRET
#   openssl rand -hex 16      # KRATOS_SECRETS_CIPHER (32 hex chars)
#   openssl rand -hex 32      # KRATOS_SECRETS_COOKIE (64 hex chars)
AUTH_JWT_SECRET=
AUTH_JWT_EXP_SEC=3600
AUTH_REFRESH_TTL_DAYS=30
KRATOS_SECRETS_CIPHER=
KRATOS_SECRETS_COOKIE=
KRATOS_PUBLIC_PORT=4433
KRATOS_ADMIN_PORT=4434

# Admin inicial (se aprovisiona automáticamente al arrancar; cámbialo en producción)
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=changeme123@

# SMTP para envío de códigos OTP (ej. Resend / Gmail / SMTP propio)
# Formato: smtp://usuario:password@smtp.tudominio.com:587/
KRATOS_SMTP_URI=
# Si quieres desactivar verificación por email en pruebas:
# SMTP_ENABLED=false
# SIGNUP_EMAIL_ENABLED=false
# RECOVERY_EMAIL_ENABLED=false

# Cloudflare R2 (opcional, S3-compatible). Sin esto, guarda uploads en volumen local.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_UPLOADS_URL=
R2_PUBLIC_PRODUCTS_URL=
R2_PUBLIC_AVATARS_URL=

# Stripe (tu propia clave secreta)
STRIPE_SECRET_KEY=

# App versions (GET /config -> version/minVersion)
APP_VERSION=1.0.0
APP_MIN_VERSION=1.0.0

# CORS (dominios permitidos separados por coma)
CORS_ORIGINS=http://localhost:3001,http://localhost:4200
